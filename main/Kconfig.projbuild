menu "智能家居 —— 项目配置"

    menu "WiFi 设置"

        config APP_WIFI_SSID
            string "WiFi 名称 (SSID)"
            default "YOUR_WIFI_SSID"
            help
                家里路由器的 2.4GHz 名称。
                注意：ESP32-S3【不支持 5GHz】，必须是 2.4GHz 频段。

        config APP_WIFI_PASSWORD
            string "WiFi 密码"
            default "YOUR_WIFI_PASSWORD"

        config APP_WIFI_MAX_RETRY
            int "WiFi 最大重连次数（超过后重启）"
            range 0 100
            default 0
            help
                0 = 永不放弃，一直重连（推荐，做产品时用这个）。

    endmenu

    menu "MQTT 设置"

        config APP_MQTT_BROKER_URI
            string "Broker 地址"
            default "mqtt://broker.emqx.io:1883"
            help
                公共测试 broker（免费、可直接用）：
                  mqtt://broker.emqx.io:1883
                  mqtt://test.mosquitto.org:1883
                自建 Mosquitto（局域网）：
                  mqtt://192.168.1.100:1883
                加密（云平台）：
                  mqtts://xxxx.iot-as-mqtt.cn-shanghai.aliyuncs.com:8883

        config APP_MQTT_USERNAME
            string "Broker 用户名（公共 broker 留空）"
            default ""

        config APP_MQTT_PASSWORD
            string "Broker 密码（公共 broker 留空）"
            default ""

        config APP_MQTT_TOPIC_PREFIX
            string "Topic 前缀"
            default "smarthome"
            help
                完整 topic = <前缀>/<唯一ID>/<子主题>
                唯一ID 默认取 MAC 后 3 字节，避免在公共 broker 上和别人撞车。
                你可以在手机端订阅 smarthome/+/+/state 看到自己设备。

        config APP_MQTT_UID_OVERRIDE
            string "唯一ID（留空=自动用 MAC 后 3 字节）"
            default ""

        config APP_MQTT_PUBLISH_SENSOR_MS
            int "传感器上报周期 (ms)"
            range 500 60000
            default 2000

        config APP_MQTT_KEEPALIVE_S
            int "Keepalive (秒)"
            range 10 300
            default 60

    endmenu

    menu "蓝牙 BLE 设置"

        config APP_BLE_ENABLE
            bool "启用蓝牙 BLE 控制链路（与 MQTT 并存）"
            default y
            help
                打开后，手机 App 可以通过 BLE GATT 控制全屋设备（和 MQTT 是【并存】
                关系，两条链路共用同一套 JSON，谁连上谁就能用）。

                ⚠ 本开关只控制"用不用 BLE 业务代码"，蓝牙协议栈本身要在
                  Component config → Bluetooth 里打开：
                    Bluetooth                          = y   (CONFIG_BT_ENABLED)
                    Host → NimBLE - BLE only           = y   (CONFIG_BT_NIMBLE_ENABLED)
                    Controller → Enabled               = y
                  （本工程 sdkconfig 已经配好，一般不用管。）

                ⚠ WiFi 与 BLE 共用 2.4GHz 射频，必须打开软件共存：
                    Component config → Wireless Coexistence
                    → Software controls WiFi/Bluetooth coexistence = y
                  （CONFIG_ESP_COEX_SW_COEXIST_ENABLE，已在 sdkconfig 里打开。）

        config APP_BLE_DEVICE_NAME_PREFIX
            string "BLE 广播名前缀"
            default "SmartHome"
            help
                最终广播名 = <前缀>-<MAC后3字节>，例如 SmartHome-a1b2c3。
                ID 的取法和 MQTT topic 前缀里的唯一 ID 完全一致
                （CONFIG_APP_MQTT_UID_OVERRIDE 优先，否则取 MAC 后 3 字节），
                这样一台板子在 MQTT 和 BLE 上能被认成同一台设备。

                ⚠ 手机端按 "SmartHome-" 这个【前缀】过滤设备，改前缀必须同步改
                  android/app/src/main/java/com/smarthome/ble/data/Contract.kt
                  里的 NAME_PREFIX，否则 App 扫不到板子。
                ⚠ 名字总长不要超过 29 字节（BLE 扫描响应包只有 31 字节），
                  超了会被截断（固件会打警告）。

    endmenu

    menu "应用行为"

        config APP_SENSOR_PERIOD_MS
            int "传感器采样周期 (ms)"
            range 500 10000
            default 1000

        config APP_OLED_ENABLE
            bool "启用 OLED 显示"
            default y

        config APP_OLED_REFRESH_MS
            int "OLED 刷新周期 (ms)"
            range 200 5000
            default 500

        config APP_AUTO_ENABLE_DEFAULT
            bool "上电后默认开启自动联动"
            default y

        config APP_SERIAL_DEBUG_ENABLE
            bool "启用串口调试台（配件没到时可先用串口模拟语音指令）"
            default y
            help
                打开后，在串口终端输入指令即可控制全屋设备，例如：
                  on led_living
                  off all
                  set fan 60
                  open door
                  say led_kitchen_on      （等价于"说了一句话"）
                  status
                  help

    endmenu

    menu "语音识别来源（二选一）"

        config APP_VOICE_SOURCE_ESP_SR
            bool "改用板载 INMP441 I²S 麦克风 + ESP-SR 离线识别（默认：关）"
            default n
            help
                ★ 这是"语音指令从哪来"的二选一开关：

                  【关】（默认）
                      外部 ASRPRO 模块，走 UART1（ESP32 TX=GPIO47 / RX=GPIO21，
                      9600 8N1），模块发命令词序号（单字节 0x01~0x19）或 ASCII
                      文本行（如 led_living_on）。
                      → 行为与本开关引入之前【完全一致】。

                  【开】
                      板载 INMP441 I²S 数字麦克风 + 乐鑫 ESP-SR 离线识别：
                      先喊唤醒词，再说命令词；识别全部在本机完成，不联网、不上云。
                      → 识别结果会被翻译成工程原有的 voice_cmd_t，调用同一个
                        voice_dispatch()，所以上层（main.c::voice_on_cmd /
                        MQTT / OLED / 自动联动）【一行都不用改】。

                ⚠ INMP441 是【I²S】接口，不是 I²C！三根信号线接：
                      SCK → GPIO13    WS → GPIO39    SD → GPIO40
                      L/R → GND（单麦必须固定接一端）    VDD → 3.3V（不要 5V）
                  完整接线表 / 命令词表 / 排错清单见 docs/13-语音模块-ESP-SR.md。

                ⚠ 打开后需要联网拉取 esp-sr 组件（含预训练模型，压缩包约 170MB），
                  说明见 main/idf_component.yml。拉取一次后即可离线编译。

                ⚠ 打开后 model 分区会被写入 srmodels.bin（约 2.8MB），
                  分区表见 partitions-16MiB.csv；改分区表后烧录必须带 erase-flash。

                ⚠ 本方案只有麦克风、没有喇叭：控制类指令正常执行；
                  "现在温度 / 播报全部"这类查询指令会走完业务链路
                  （OLED 显示、MQTT 事件），但【不会出声】。
                  将来要做语音播报，esp-sr 自带中文 TTS，需另加功放+喇叭。

        # ---- 只做"编译期自检"的隐藏符号，没有 prompt（menuconfig 里看不到） ----
        config APP_VOICE_SR_MODEL_CHECK
            bool
            depends on APP_VOICE_SOURCE_ESP_SR
            default y
            help
                打开 ESP-SR 后强制为 y。voice_esp_sr.c 用它 + CONFIG_SR_WN_* /
                CONFIG_SR_MN_* 做一致性检查：一个模型都没选就直接 #error，
                并告诉你该去哪个菜单选，而不是等烧录后运行时才发现。

        # ★ 唤醒词模型和命令词模型【不在本菜单里】——它们在 esp-sr 组件自己的
        #   菜单里（那些选项带 prompt，既不能被 select，重复定义同名 config
        #   又有产生重名符号的风险）。见下面这段注释。
        #
        #     menuconfig → ESP Speech Recognition
        #        ├─ Load Multiple Wake Words (WakeNet9s)     ← 唤醒词在这里选
        #        │     [*] 你好小智 (wn9s_nihaoxiaozhi)      ★ 本工程选它
        #        │     [ ] Hi,乐鑫   (wn9s_hilexin)
        #        │     [ ] Hi,ESP    (wn9s_hiesp)
        #        ├─ Chinese Speech Commands Model            ← 命令词模型在这里选
        #        │     [*] general chinese recognition (mn7_cn)   ★ 本工程选它
        #        ├─ Select noise suppression model
        #        └─ Select voice activity detection
        #
        #   sdkconfig.defaults 里已经把这几个选项的默认值写好了（只对"首次编译、
        #   还没有 sdkconfig"生效）；已经编译过的工程请用 menuconfig 打开确认一次。
        #
        #   ⚠ 换了模型之后：命令词表不用改（命令词是运行时注册的），
        #     但 model 分区大小可能要调，容量计算见 partitions-16MiB.csv。

    endmenu

endmenu
