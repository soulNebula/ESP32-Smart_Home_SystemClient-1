# 配置项目参数，编译时会把这些参数写进固件
menu "Smart Home -- Project Config"

    menu "WiFi Settings"

        # WiFi 名称与密码不在这里配，改 components/App/wifi_config.h 那两行就行。
        # 这样密码不会写进 sdkconfig，交付打包时也不会跟着漏出去。

        config APP_WIFI_MAX_RETRY
            int "WiFi 最大重连次数，超时重启"
            range 0 100
            default 0
            help
                0 = 永不放弃，一直重连

    endmenu

    menu "MQTT Settings"

        config APP_MQTT_BROKER_URI
            string "Broker 地址"
            default "mqtt://broker.emqx.io:1883"
            help
                公共测试 broker：
                  mqtt://broker.emqx.io:1883
                  mqtt://test.mosquitto.org:1883
                自建 Mosquitto：
                  mqtt://192.168.1.100:1883
                加密：
                  mqtts://xxxx.iot-as-mqtt.cn-shanghai.aliyuncs.com:8883

        config APP_MQTT_USERNAME
            string "Broker 用户名"
            default ""

        config APP_MQTT_PASSWORD
            string "Broker 密码"
            default ""

        config APP_MQTT_TOPIC_PREFIX
            string "Topic 前缀"
            default "smarthome"
            help
                完整 topic = <前缀>/<唯一ID>/<子主题>
                唯一ID 默认取 MAC 后 3 字节，避免在公共 broker 上和别人撞车
                你可以在手机端订阅 smarthome/+/+/state 看到自己设备

        config APP_MQTT_UID_OVERRIDE
            string "唯一ID"
            default ""

        config APP_MQTT_PUBLISH_SENSOR_MS
            int "传感器上报周期 (ms)"
            range 500 60000
            default 2000

        config APP_MQTT_KEEPALIVE_S
            int "Keepalive 时间 (s)"
            range 10 300
            default 60

    endmenu

    menu "Bluetooth BLE Settings"

        config APP_BLE_ENABLE
            bool "启用蓝牙 BLE 控制链路"
            default y
            help
                打开后，手机 App 可以通过 BLE GATT 控制全屋设备（和 MQTT 是【并存】
                关系，两条链路共用同一套 JSON，谁连上谁就能用）

                只控制"用不用 BLE 业务代码"，蓝牙协议栈本身要在
                  Component config → Bluetooth 里打开：
                    Bluetooth                          = y   (CONFIG_BT_ENABLED)
                    Host → NimBLE - BLE only           = y   (CONFIG_BT_NIMBLE_ENABLED)
                    Controller → Enabled               = y   (CONFIG_BT_NIMBLE_CONTROLLER)
                WiFi 与 BLE 共用 2.4GHz 射频，必须打开软件共存：

        config APP_BLE_DEVICE_NAME_PREFIX
            string "BLE 广播名前缀"
            default "SmartHome"
            help
                最终广播名 = <前缀>-<MAC后3字节>，例如 SmartHome-a1b2c3
                ID 的取法和 MQTT topic 前缀里的唯一 ID 完全一致
                （CONFIG_APP_MQTT_UID_OVERRIDE 优先，否则取 MAC 后 3 字节），
                这样一台板子在 MQTT 和 BLE 上能被认成同一台设备

                手机端"SmartHome-", 前缀过滤设备，改前缀必须同步改
                  android/app/src/main/java/com/smarthome/ble/data/Contract.kt
                  里的 NAME_PREFIX，否则 App 扫不到板子
                名字总长不要超过 29 字节,避免 BLE 广播包超长，
                  超了会被截断

    endmenu

    menu "App Behavior"

        # 默认毫秒
        config APP_SENSOR_PERIOD_MS
            int "传感器采样周期"
            range 500 10000
            default 500

        config APP_OLED_ENABLE
            bool "启用 OLED 显示"
            default y

        config APP_OLED_REFRESH_MS
            int "OLED 刷新周期"
            range 200 5000
            default 500

        config APP_AUTO_ENABLE_DEFAULT
            bool "上电后默认开启自动联动"
            default y

        config APP_SERIAL_DEBUG_ENABLE
            bool "启用串口调试台"
            default y
            help
                打开后，在串口终端输入指令即可控制全屋设备，例如：
                  on led_living
                  off all
                  set fan 60
                  open door
                  say led_kitchen_on
                  status
                  help

    endmenu

endmenu
