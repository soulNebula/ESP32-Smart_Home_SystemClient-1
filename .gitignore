# ESP-IDF构建产物
build/
sdkconfig
sdkconfig.old

# 构建日志，本地数据，不入库
build_log*.txt

# 组件管理器自动下载的东西
managed_components/
dependencies.lock
.esp-sr-probe/

# 编辑器和系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# 串口监视器日志
logs/

# ---------------------------------------------------------------------------
# 本工程自带的绿色沙箱 .idf-sandbox/
#
# 只忽略"体积大 + 和本机绑定"的那几块（环境本体）；
# 入口脚本和 tools/ 是要入库的，所以不能整个目录一刀切 ——
# .idf-sandbox/ 下面留着的 start.py、tools/*.py、README.md 都正常入库。
# ---------------------------------------------------------------------------
.idf-sandbox/python/
.idf-sandbox/penv/
.idf-sandbox/idf/
.idf-sandbox/idf_tools/
.idf-sandbox/drivers/
.idf-sandbox/logs/
.idf-sandbox/tmp/
.idf-sandbox/state.json
.idf-sandbox/download/
.idf-sandbox/download-linux/

# Linux 那一套（同样的东西，ELF 版）
.idf-sandbox/python-linux/
.idf-sandbox/penv-linux/
.idf-sandbox/idf_tools-linux/


# Android 构建产物与本地配置
android/.gradle/
android/build/
android/app/build/
android/captures/
android/local.properties
android/.idea/
android/*.iml

# Arduino/编译中间产物（里面是本机绝对路径，没意义）
voice.d
*.d
*.o
*.obj
